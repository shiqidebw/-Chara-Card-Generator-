# 复制本文件为 .env 后修改即可生效（.env 不纳入版本控制）

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
# 排障时改为 DEBUG 可看到请求耗时、样本条数、prompt 体积等细节
LOG_LEVEL=INFO

# 日志目录（相对项目根目录，也可填绝对路径）
LOG_DIR=logs

# 按天滚动的日志文件保留天数
LOG_RETENTION_DAYS=30

# 是否记录每个请求的耗时（毫秒）：1 开启 / 0 关闭
LOG_TIMING=1

# ---------- 数据自动清理 ----------
# 是否开启定时清理：1 开启 / 0 关闭
CLEANUP_ENABLED=1

# 保留天数：早于 now - N 天的上传记录会被删除（关联消息由外键级联清理，人格卡不受影响）
CLEANUP_RETENTION_DAYS=7

# 自动清理执行间隔（天）
CLEANUP_INTERVAL_DAYS=1

# 启动时是否先跑一次清理：1 开启 / 0 关闭（调试或回溯旧数据时可设 0）
CLEANUP_ON_START=1

# 总消息数超过该阈值时，前端提示建议清理
MESSAGE_WARN_THRESHOLD=10000

# ---------- 接口限流 ----------
# 限流总开关：1 开启 / 0 关闭（本地单机自用且嫌麻烦时可设 0）
RATE_LIMIT_ENABLED=1

# 全局兜底，多条用逗号分隔（/chat、/history 等交互路由走这里）
RATE_LIMIT_DEFAULT=200 per hour

# 高消耗路由单独限流
RATE_LIMIT_GENERATE=5 per minute
RATE_LIMIT_EVALUATE=10 per minute
RATE_LIMIT_UPLOAD=20 per minute
RATE_LIMIT_PROJECT_IO=30 per hour

# 存储后端：单机用内存即可；多实例部署改成 redis://host:port/0
RATE_LIMIT_STORAGE_URI=memory://
